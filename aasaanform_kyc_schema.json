{
  "schema_version": "1.0",
  "form_name": "HDFC Bank KYC Application Form (Resident Individuals)",
  "note": "Use only with the official form supplied by the user. Do not invent values. Fields marked customer_confirmation require explicit customer input/confirmation.",
  "sections": [
    {
      "id": "customer_details",
      "title": "1. Customer Details"
    },
    {
      "id": "profile_details",
      "title": "Customer Profile Details"
    },
    {
      "id": "identity_address_proof",
      "title": "2. (A) Proof of Identity & Current/Permanent Address"
    },
    {
      "id": "contact_details",
      "title": "3. Contact Details"
    },
    {
      "id": "completion",
      "title": "Declaration and completion"
    }
  ],
  "status_values": [
    "matched",
    "missing",
    "conflict",
    "needs_review",
    "customer_confirmation_required"
  ],
  "global_rules": [
    "Only auto-fill values supported by source documents and validated evidence.",
    "Never infer a missing personal value from unrelated fields.",
    "If sources disagree, leave the PDF field blank and flag conflict for user review.",
    "Customer declarations, consent, tax residency, PEP answers and preferences require explicit customer confirmation.",
    "Never generate a signature or fabricate a photograph.",
    "Do not mark original-document verification as complete; this is a bank-only action.",
    "Sensitive identifiers should be masked in logs and UI where possible."
  ],
